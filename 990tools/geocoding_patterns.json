{
  "version": "1.0",
  "description": "Geocoding patterns for automatic resolution of common address issues",
  "patterns": [
    {
      "regex": "(?i)(the organization|see attached|detailed address information|same as c above|c/o org)",
      "colocator": "BOGUS:Placeholder",
      "status": "No_Match:Invalid",
      "priority": 1
    },
    {
      "name": "privacy_addresses",
      "description": "Addresses that charities choose not to disclose",
      "regex": "(?i)(Individual Contrbutions|Trustee Maintains List Of Addresses|available upon request|upon request|on file|address available on request|see.*attached|attached|Detailed Address Information)",
      "colocator": "PRIV:{zip}",
      "status": "owner",
      "priority": 1
    },
    {
      "name": "exempt_addresses",
      "description": "Addresses that charities claim are exempt from disclosure",
      "regex": "(?i)(exempt))",
      "colocator": "EXEMPT:{zip}",
      "status": "owner",
      "priority": 1
    },
    {
      "name": "po_box_addresses",
      "description": "PO Box addresses that need proper colocator",
      "regex": "(?i)(p\\.?\\s*o\\.?\\s*box|p\\s*o\\s*box|\\bbox\\b)",
      "colocator": "PO:BOX:{zip}",
      "status": "pending",
      "priority": 2
    },
    {
      "name": "co_addresses",
      "description": "Care of addresses with entity names",
      "regex": "(?i)^c/o\\s+(.+?),\\s*",
      "action": "strip",
      "status": "pending",
      "priority": 3
    },
    {
      "name": "various_addresses",
      "description": "Multi-location organizations",
      "regex": "(?i)(various|multiple|several)",
      "colocator": "MULTI:{city}:{state}:{zip}",
      "status": "pending",
      "priority": 4
    },
    {
      "name": "mall_complexes",
      "description": "Shopping malls and complexes",
      "regex": "(?i)(mall|center|plaza|square|courtyard|commons|village|crossing|junction|pavilion|atrium)",
      "colocator": "MALL:{location}:{zip}",
      "status": "pending",
      "priority": 5
    },
